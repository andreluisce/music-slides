{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "*"
      ],
      "@main/*": [
        "main/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    ".",
    "main",
    "shared"
  ],
  "exclude": [
    "dist",
    "dist-electron",
    "dist_electron_builder",
    "vite.config.ts"
  ]
}